# Derived CSV artifacts use their generator's original CRLF bytes. Preserve
# those bytes so committed artifact manifests remain valid, and treat CR as
# part of the line ending for whitespace checks.
*.csv -text whitespace=cr-at-eol

# Matplotlib SVG path data commonly carries spaces before line breaks.
*.svg whitespace=-blank-at-eol,-blank-at-eof

# Preserve the byte-level provenance of the 08 September derived package.
/analysis/water_08_09_26_results/** -text whitespace=cr-at-eol
/analysis/water_08_09_26_results/**/*.svg whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Preserve the byte-level provenance of the 12 September D3 derived packages.
/analysis/glycerol_99p7_D3_*_results/** -text whitespace=cr-at-eol
/analysis/glycerol_99p7_D3_*_results/**/*.svg whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
